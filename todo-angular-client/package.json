{
	"name": "todo-angular-client",
	"version": "1.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"lint": "prettier --check . && ng lint",
		"lint-fix": "prettier --list-different --write . && ng lint --fix",
		"format": "prettier --list-different --write .",
		"show-deps-updates": "npm-check-updates",
		"update-deps": "npm-check-updates -u && npm install",
		"ci": "npm run lint && npm run build && npm run test"
	},
	"prettier": {
		"bracketSameLine": true,
		"printWidth": 100,
		"singleQuote": true,
		"trailingComma": "none",
		"useTabs": true,
		"overrides": [
			{
				"files": "*.html",
				"options": {
					"parser": "angular"
				}
			}
		]
	},
	"type": "module",
	"private": true,
	"packageManager": "npm@12.2.1",
	"dependencies": {
		"@angular/cdk": "^22.2.5",
		"@angular/common": "^22.2.3",
		"@angular/compiler": "^22.2.3",
		"@angular/core": "^22.2.3",
		"@angular/forms": "^22.2.3",
		"@angular/material": "^22.2.5",
		"@angular/platform-browser": "^22.2.3",
		"@angular/router": "^22.2.3",
		"@eslint/js": "^10.0.1",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"dompurify": "^3.4.17",
		"highlight.js": "^11.12.0",
		"marked": "^18.1.2",
		"marked-highlight": "^2.2.4",
		"openai": "^7.45.1",
		"rxjs": "~7.8.2",
		"tslib": "^2.8.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@angular/build": "^22.2.5",
		"@angular/cli": "^22.2.5",
		"@angular/compiler-cli": "^22.2.3",
		"@eslint/css": "^2.0.1",
		"@vitest/coverage-v8": "^5.0.5",
		"angular-eslint": "^22.6.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"jsdom": "^30.1.3",
		"npm-check-updates": "^23.1.1",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	}
}
